# Server Configuration
PORT=8080
GIN_MODE=release

# Upload Configuration
UPLOAD_MAX_SIZE=104857600  # 100MB in bytes
UPLOAD_DIR=./uploads

# Analysis Configuration
ANALYSIS_TIMEOUT=300  # 5 minutes in seconds
MAX_CONCURRENT_ANALYSES=10

# Cleanup Configuration
CLEANUP_ENABLED=true
CLEANUP_INTERVAL=3600  # 1 hour in seconds
FILE_MAX_AGE=86400     # 24 hours in seconds

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization

# Python Parser Configuration
PYTHON_SCRIPT_PATH=./scripts/parse_protein.py
USE_MOCK_PARSER=true  # Set to false when BioPython is installed